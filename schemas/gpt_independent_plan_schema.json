{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gpt_independent_plan_schema.json",
  "title": "GPT Independent Plan (first pass)",
  "description": "GPT 독립 첫 패스 플랜(S13 · scripts/gpt_independent.sh plan) — gpt-skills/fz-planner 출력 형식. steps · riskMatrix 는 scripts/plan_divergence.py --gpt 입력이다. $ref · oneOf 없이 자기완결 — 모든 필드 required · 선택은 type 배열의 null(S11 ④). status=rejected 면 reason 을 채우고 배열은 비운다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "reason", "approach", "affectedFiles", "steps", "riskMatrix", "stressTest", "implicationRegister", "divergencePoints", "projectRules", "catalogHits"],
  "properties": {
    "status": {"type": "string", "enum": ["ok", "rejected"]},
    "reason": {"type": ["string", "null"], "description": "rejected 일 때 claude_plan_detected · requirements_missing"},
    "approach": {"type": "string"},
    "affectedFiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["new", "modified"],
      "properties": {"new": {"type": "integer", "minimum": 0}, "modified": {"type": "integer", "minimum": 0}}
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "files", "action", "why"],
        "properties": {
          "file": {"type": ["string", "null"], "description": "저장소 루트 상대 경로 하나 — 여러 파일이면 null 로 두고 files 에"},
          "files": {"type": ["array", "null"], "items": {"type": "string"}},
          "action": {"type": "string", "enum": ["create", "modify", "delete"]},
          "why": {"type": "string"}
        }
      }
    },
    "riskMatrix": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk", "q", "layer", "mitigation"],
        "properties": {"risk": {"type": "string"}, "q": {"type": "string"}, "layer": {"type": "string"}, "mitigation": {"type": "string"}}
      }
    },
    "stressTest": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["q", "result", "note"],
        "properties": {"q": {"type": "string"}, "result": {"type": "string", "enum": ["pass", "warn", "fail"]}, "note": {"type": "string"}}
      }
    },
    "implicationRegister": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "trigger", "locus", "reason", "policy", "status"],
        "properties": {
          "id": {"type": "string"},
          "type": {"type": "string", "enum": ["exec", "obs"]},
          "trigger": {"type": "string"},
          "locus": {"type": "string"},
          "reason": {"type": "string"},
          "policy": {"type": "string"},
          "status": {"type": "string", "enum": ["needs_user_confirmation", "report_only"]}
        }
      }
    },
    "divergencePoints": {"type": "array", "items": {"type": "string"}},
    "projectRules": {
      "type": "object",
      "description": "모델이 원문에서 각자 만든 규칙 레코드 — modules/project-rules.md §3 모양(schemaVersion 제외).",
      "additionalProperties": false,
      "required": ["axes", "rules", "conflicts", "gaps"],
      "properties": {
        "axes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["architecturePattern", "uiStack", "dependencyDirection", "naming", "placement", "conventions"],
          "properties": {
            "architecturePattern": {"type": ["string", "null"]},
            "uiStack": {"type": ["string", "null"]},
            "dependencyDirection": {"type": ["string", "null"]},
            "naming": {"type": ["string", "null"]},
            "placement": {"type": ["string", "null"]},
            "conventions": {"type": ["string", "null"]}
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "axis", "authority", "appliesTo", "condition", "expectedResult", "source", "appliedTo"],
            "properties": {
              "id": {"type": "string"},
              "axis": {"type": "string", "enum": ["architecturePattern", "uiStack", "dependencyDirection", "naming", "placement", "conventions"]},
              "authority": {"type": "string", "enum": ["지침", "관례", "예시"]},
              "appliesTo": {
                "type": "object",
                "additionalProperties": false,
                "required": ["languages", "modules", "paths"],
                "properties": {
                  "languages": {"type": "array", "items": {"type": "string"}},
                  "modules": {"type": "array", "items": {"type": "string"}},
                  "paths": {"type": "array", "items": {"type": "string"}}
                }
              },
              "condition": {"type": "string"},
              "expectedResult": {"type": "string"},
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": ["file", "line", "quote"],
                "properties": {"file": {"type": "string"}, "line": {"type": "integer", "minimum": 1}, "quote": {"type": "string"}}
              },
              "appliedTo": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["axis", "claim_a", "claim_b", "sources"],
            "properties": {
              "axis": {"type": "string", "enum": ["architecturePattern", "uiStack", "dependencyDirection", "naming", "placement", "conventions"]},
              "claim_a": {"type": "string"},
              "claim_b": {"type": "string"},
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["file", "line", "quote"],
                  "properties": {"file": {"type": "string"}, "line": {"type": "integer", "minimum": 1}, "quote": {"type": "string"}}
                }
              }
            }
          }
        },
        "gaps": {"type": "array", "items": {"type": "string", "enum": ["architecturePattern", "uiStack", "dependencyDirection", "naming", "placement", "conventions"]}}
      }
    },
    "catalogHits": {"type": ["array", "null"], "description": "점검 카탈로그(역할 스킬 Check Catalog) 중 해당한 항목. null 은 카탈로그 블록을 받지 못한 경로다(catalog_hits_report.py 가 경로 단위 unchecked 로 센다). 해당 항목이 없으면 빈 배열",
      "items": {"type": "object", "additionalProperties": false, "required": ["catalogId", "target", "verdict"],
        "properties": {"catalogId": {"type": "string", "description": "카탈로그 행 id(F-NNN)"}, "target": {"type": "string", "description": "파일:줄 또는 대상 — unchecked 면 이유"},
          "verdict": {"type": "string", "enum": ["hit", "clear", "unchecked"]}}}}
  }
}
