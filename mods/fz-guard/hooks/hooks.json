{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|Write|Edit|MultiEdit|NotebookEdit|Workflow|Agent|Task|Skill|mcp__.*serena__(replace_symbol_body|insert_after_symbol|insert_before_symbol|replace_content|replace_in_files|rename_symbol|safe_delete_symbol)|mcp__xcode__Xcode(Write|Update|MV|RM|MakeDir))$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(AskUserQuestion|Write|Edit|MultiEdit|NotebookEdit|mcp__.*serena__(replace_symbol_body|insert_after_symbol|insert_before_symbol|replace_content|replace_in_files|rename_symbol|safe_delete_symbol)|mcp__xcode__Xcode(Write|Update|MV|RM|MakeDir))$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
