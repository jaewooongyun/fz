+import UIKit
+
+// MARK: - 실험실 플레이어 스와이프 제스처 (Lab 토글 `playerSwipeGesture` 전용)
+// Release 빌드에선 아래 enum·extension 전체가 컴파일 제외된다.
+#if Lab
+
+    /// 실험실(Lab 토글 `playerSwipeGesture`) 전용 플레이어 스와이프 제스처 튜닝 값(실기기 체감 기준 조정 대상). 한 곳에서 관리해 반복 조정을 쉽게 한다.
+    enum PlayerGestureTuning {
+        /// expand 시 손가락 이동량 대비 배율 증가 gain. 높을수록 빨리 커지고 commit도 빨라진다.
+        static let expandSensitivity: CGFloat = 1.3
+        /// expand commit 임계 — scaleMax까지 진행률(0~1). 이 비율 이상 끌고 놓으면 전체화면 전환.
+        static let expandCommitRatio: CGFloat = 0.7
+        /// collapse 시 손가락 하강량 대비 아래 translate 배율. 1.0 = 1:1.
+        static let collapseSensitivity: CGFloat = 1.0
+        /// collapse commit 임계 — 플레이어 높이 대비 손가락 하강 비율(0~1). 이 비율 이상 내리고 놓으면 세로 복귀.
+        static let collapseCommitRatio: CGFloat = 0.4
+        /// 빠른 플릭 commit 속도 임계(pt/s). 낮을수록 가벼운 플릭에도 전환.
+        static let flickVelocity: CGFloat = 1200
+        /// 임계 미달 시 원위치로 되돌리는 스프링 복원 애니메이션 파라미터.
+        static let snapBackDuration: TimeInterval = 0.3
+        static let snapBackDamping: CGFloat = 0.8
+        static let snapBackInitialVelocity: CGFloat = 0.5
+    }
+    //
+    // 아래 메서드는 ContentDetailInteractor.bindPlayerSwipeGestures()(#if Lab 게이팅)에서만 호출된다.
+    // 토글 OFF·릴리즈 빌드에선 구독이 생성되지 않아 실행되지 않는다.
+    extension ContentDetailViewController {
+
+        // 세로모드: 위로 팬 → 비율 유지 확대(center anchor uniform scale, 세이프에어리어 무시).
+        // 확대 제스처 공통 로직: 대상 뷰(playerContainer 또는 playerPreview)만 다르므로 뷰를 주입받는다.
+        // 위로 팬 → 상단이 디바이스 최상단(y≈0)에 닿는 배율에서 clamp. 커밋 판정은 listener(Interactor).
+        private func handleExpand(
+            _ gesture: UIPanGestureRecognizer,
+            on view: UIView,
+            onEnded: (_ reachedTop: Bool, _ velocity: CGPoint) -> Void
+        ) {
+            let translation = gesture.translation(in: gesture.view)
+            switch gesture.state {
+            case .began:
+                view.layer.removeAllAnimations()
+            case .changed:
+                // 손가락의 수직 위치를 연속 추적(대각선/좌우로 가도 위 성분을 따라 확대). 좌우/대각선의
+                // commit 오발동은 .ended의 수직 우세 판정이 막으므로, 추적 자체는 막지 않는다.
+                guard translation.y < 0 else { return }
+                let height = view.bounds.height
+                guard height > 0 else { return }
+                let scale = min(1 + (-translation.y) * PlayerGestureTuning.expandSensitivity / height, expandScaleMax(height: height))
+                view.transform = CGAffineTransform(scaleX: scale, y: scale)
+            case .ended, .cancelled:
+                let height = view.bounds.height
+                guard height > 0 else {
+                    onEnded(false, gesture.velocity(in: gesture.view))
+                    return
+                }
+                let scaleMax = expandScaleMax(height: height)
+                // .changed와 동일 조건(위 방향 + 수직 우세)일 때만 commit 거리 인정 — 대각선/좌우는 미커밋.
+                // stale transform.a 의존 제거 + .changed가 차단한 대각선이 .ended로 새는 것 방지.
+                let isVerticallyDominant = abs(translation.y) > abs(translation.x)
+                let upwardDistance = (translation.y < 0 && isVerticallyDominant) ? -translation.y : 0
+                let scale = min(1 + upwardDistance * PlayerGestureTuning.expandSensitivity / height, scaleMax)
+                let progress = scaleMax > 1 ? (scale - 1) / (scaleMax - 1) : 0
+                let reachedTop = progress >= PlayerGestureTuning.expandCommitRatio
+                onEnded(reachedTop, gesture.velocity(in: gesture.view))
+            default:
+                break
+            }
+        }
