+        // 플레이어 상단을 디바이스 최상단(y=0)까지 올리는 배율 (center anchor 기준, 실기기 튜닝 대상).
+        private func expandScaleMax(height: CGFloat) -> CGFloat {
+            guard height > 0 else { return 1 }
+            return 1 + (2 * max(view.safeAreaInsets.top, 0)) / height
+        }
+
+        // transform 스냅백 공통 로직: 대상 뷰만 다르다.
+        private func resetTransform(of view: UIView) {
