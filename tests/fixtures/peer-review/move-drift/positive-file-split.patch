+            case .began:
+                view.layer.removeAllAnimations()
+            case .changed:
+                // 손가락의 수직 위치를 연속 추적(대각선/좌우로 가도 y를 따라 이동). 좌우/대각선의 commit
+                // 오발동은 .ended의 velocity 수직 우세 판정이 막으므로, 추적 자체는 막지 않는다.
+                guard translation.y > 0 else { return }
+                view.transform = CGAffineTransform(translationX: 0, y: translation.y * PlayerGestureTuning.collapseSensitivity)
