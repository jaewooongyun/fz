+        func handleExpandGesture(_ gesture: UIPanGestureRecognizer) {
+            handleExpand(gesture, on: playerContainer) { reachedTop, velocity in
+                listener?.handleExpandGestureEnded(reachedTop: reachedTop, velocity: velocity)
+            }
+        }
