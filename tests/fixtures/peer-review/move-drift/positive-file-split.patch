+        // 축소(collapse) 공통 로직: 대상 뷰만 다르므로 뷰를 주입받는다.
+        // 전체화면(landscape): 아래로 팬 → 플레이어만 아래로 translate(위 빈 공간은 view 검정 배경).
+        // 절반쯤 도달 판정은 listener(Interactor).
+        private func handleCollapse(
+            _ gesture: UIPanGestureRecognizer,
+            on view: UIView,
+            onEnded: (_ translation: CGPoint, _ velocity: CGPoint) -> Void
