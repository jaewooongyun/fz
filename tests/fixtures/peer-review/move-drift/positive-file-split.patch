+        func handleCollapseGesture(_ gesture: UIPanGestureRecognizer) {
+            handleCollapse(gesture, on: playerContainer) { translation, velocity in
+                listener?.handleCollapseGestureEnded(translation: translation, velocity: velocity)
+            }
+        }
