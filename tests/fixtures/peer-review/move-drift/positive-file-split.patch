+// MARK: - 실험실 플레이어 스와이프 제스처 (Lab 토글 `playerSwipeGesture` 전용)
+//
+// 선언(Presentable/Listener 프로토콜)·구현·상태 프로퍼티를 모두 #if Lab으로 게이팅한다.
+// Release 빌드에선 아래 extension 전체가 컴파일 제외된다.
+#if Lab
+
+    extension ContentDetailInteractor {
+
+        /// 유튜브식 스와이프 제스처(세로 확대→전체화면 / 전체화면 collapse→세로 복귀) 구독.
+        /// 실험실(Lab 전용) 토글이 켜졌을 때만 bind()에서 호출된다.
+        func bindPlayerSwipeGestures() {
+            // 유튜브식 확대/축소 제스처 (iPhone): playerContainer 단일 pan을 isFullView로 분기
+            // 인터럽트 관찰자: 플레이어 밖에서 터치가 시작되면(다른 이벤트의 시작) 진행 중 제스처를 강제 종료.
+            // tap의 touchReceptionPolicy(=shouldReceive)를 매 터치다운 관찰자로만 쓴다 — 항상 false 반환해 인식하지 않음.
+            presenter.contentView.rx.tapGesture { recognizer, delegate in
+                recognizer.cancelsTouchesInView = false
+                delegate.simultaneousRecognitionPolicy = .always
+                delegate.touchReceptionPolicy = .custom({ [weak self] _, touch in
+                    guard let self else { return false }
+                    let pointInPlayer = touch.location(in: self.presenter.playerContainer)
+                    if !self.presenter.playerContainer.bounds.contains(pointInPlayer) {
+                        self.cancelPlayerSwipeGestures()
+                    }
+                    return false
+                })
+            }
+            .subscribe(with: self) { _, _ in }
+            .disposeOnDeactivate(interactor: self)
+
+            presenter.playerContainer.rx.panGesture { [weak self] recognizer, delegate in
+                self?.playerContainerPan = recognizer
+                recognizer.maximumNumberOfTouches = 1
+                delegate.simultaneousRecognitionPolicy = .always
+                delegate.touchReceptionPolicy = .custom({ _, touchGesture in
+                    !(touchGesture.view is UIButton)
+                })
+            }
+            .when(.began, .changed, .ended, .cancelled)
+            .withLatestFrom(
+                Observable.combineLatest(
+                    mutableCurrentPlayerStream.isFullView,
+                    mutableCurrentPlayerStream.isAdActive
+                )
+            ) { ($0, $1.0, $1.1) }
+            .subscribe(with: self) { interactor, tuple in
+                let (gesture, isFullView, isAdActive) = tuple
+
+                // 컨트롤 복원(false)은 가드 밖에서 항상 실행. 드래그 도중 광고가 시작되면 .ended가
+                // 아래 isAdActive 가드에 막혀 복원이 안 돼 컨트롤이 영구 숨김 고착됨(C1).
+                // 같은 이유로 광고 활성 시 핸들러가 막혀 transform이 잔류하므로 함께 초기화.
+                if gesture.state == .ended || gesture.state == .cancelled {
+                    Task { @MainActor [weak interactor] in
+                        interactor?.mutableCurrentPlayerStream.player?.isControlForcedHidden = false
+                    }
+                    if isAdActive {
+                        interactor.presenter.resetPlayerContainerTransform()
+                    }
+                }
+
+                // iPhone 한정 + 광고 재생 중 차단(광고 컨트롤 좌표 불일치 방지)
+                guard isIPHONE, !isAdActive else { return }
+
+                // 시스템 취소(전화/경쟁 인식기 등)는 abort — 스냅백만 하고 commit 판정은 하지 않는다.
+                if gesture.state == .cancelled {
+                    interactor.presenter.resetPlayerContainerTransform()
+                    return
+                }
+
+                switch gesture.state {
+                case .began:
+                    if isFullView {
+                        // collapse 시작 시점의 재생 상태 캡처 (currentStatus: 동기, @MainActor 무관)
+                        if case .play = interactor.mutableCurrentPlayerStream.currentStatus {
+                            interactor.collapseStartWasPlaying = true
+                        } else {
+                            interactor.collapseStartWasPlaying = false
+                        }
+                    }
+                    Task { @MainActor [weak interactor] in
+                        interactor?.mutableCurrentPlayerStream.player?.isControlForcedHidden = true
+                    }
+                default:
+                    break
+                }
+
+                if isFullView {
+                    interactor.presenter.handleCollapseGesture(gesture)
+                } else {
+                    interactor.presenter.handleExpandGesture(gesture)
+                }
+            }
+            .disposeOnDeactivate(interactor: self)
+
+            // 재생 전 미리보기 상태: playerPreview가 playerContainer를 덮어 터치를 가로채므로
+            // preview에도 확대 pan을 붙여 위로 팬 시 재생 + 전체화면을 트리거 (커밋 시)
+            presenter.playerPreview.rx.panGesture { [weak self] recognizer, delegate in
+                self?.playerPreviewPan = recognizer
+                recognizer.maximumNumberOfTouches = 1
+                delegate.simultaneousRecognitionPolicy = .always
+                delegate.touchReceptionPolicy = .custom({ _, touchGesture in
+                    !(touchGesture.view is UIButton)
+                })
+            }
+            .when(.began, .changed, .ended, .cancelled)
+            .withLatestFrom(
+                Observable.combineLatest(
+                    mutableCurrentPlayerStream.isFullView,
+                    mutableCurrentPlayerStream.isAdActive
+                )
+            ) { ($0, $1.0, $1.1) }
+            .subscribe(with: self) { interactor, tuple in
+                let (gesture, isFullView, isAdActive) = tuple
+                // 드래그 종료 시 컨트롤 강제숨김 복원(광고로 아래 가드에 막혀도 항상). 광고 중이면 transform도 정리
+                // — .ended/.cancelled가 isAdActive 가드에 막혀 잔류하는 것을 컨테이너 경로와 동일하게 방지.
+                if gesture.state == .ended || gesture.state == .cancelled {
+                    interactor.presenter.playerPreview.setControlsHidden(false)
+                    if isAdActive {
+                        interactor.presenter.resetPlayerPreviewTransform()
+                    }
+                }
+                // playerContainer 제스처와 동일하게 광고 중 차단 (preview→재생+전체화면 오발동 방지)
+                guard isIPHONE, !isAdActive else { return }
+                // 드래그 시작 시 미리보기 컨트롤(재생버튼 등) 숨김 — 플레이어 isControlForcedHidden과 동일 취지.
+                if gesture.state == .began {
+                    interactor.presenter.playerPreview.setControlsHidden(true)
+                }
+                // 시스템 취소는 abort — 미리보기 스냅백만, 재생/전체화면 commit은 하지 않는다.
+                if gesture.state == .cancelled {
+                    interactor.presenter.resetPlayerPreviewTransform()
+                    return
+                }
+                // playerContainer pan과 대칭으로 isFullView 분기: 세로는 위로 스와이프 시 재생+확대,
+                // 가로(이미 전체화면)는 아래로 스와이프 시 collapse(세로 복귀)·위로는 inert.
+                // 가로에서 위로가 재생을 오발동하던 버그를 막으면서 아래로 collapse 기능은 보존한다.
+                if isFullView {
+                    interactor.presenter.handlePreviewCollapseGesture(gesture)
+                } else {
+                    interactor.presenter.handlePreviewExpandGesture(gesture)
+                }
+            }
+            .disposeOnDeactivate(interactor: self)
+        }
+
+        /// 진행 중인 플레이어 스와이프 제스처를 강제 종료한다 (다른 이벤트 끼어들 때).
+        /// isEnabled 토글로 현재 인식 시퀀스를 .cancelled 처리 → 기존 cancel-abort(transform 복원 + commit 스킵)로 정리.
+        /// 진행 중이 아니면 무해한 no-op. held finger는 새 터치 전까지 재추적되지 않는다.
+        private func cancelPlayerSwipeGestures() {
+            [playerContainerPan, playerPreviewPan].forEach { recognizer in
+                recognizer?.isEnabled = false
+                recognizer?.isEnabled = true
+            }
+        }
+
+        func handleExpandGestureEnded(reachedTop: Bool, velocity: CGPoint) {
+            // 멀티뷰는 landscape 고정이라 forceUpdateDeviceOrientation이 no-op → 회전 트랜지션이
+            // 안 일어나 transform이 고착됨. 진입을 막고 스프링 복원으로 보낸다.
+            guard isIPHONE, !mutableCurrentPlayerStream.isFullViewValue,
+                !mutableCurrentPlayerStream.isMultiViewMode
+            else {
+                presenter.resetPlayerContainerTransform()
+                return
+            }
+            // commit 임계까지 끌었거나(reachedTop) 빠른 위 플릭이면 전체화면 전환, 아니면 세로로 복귀
+            let isVerticallyDominant = abs(velocity.y) > abs(velocity.x)
+            let isFastUpwardFlick = velocity.y < -PlayerGestureTuning.flickVelocity && isVerticallyDominant
+            if reachedTop || isFastUpwardFlick {
+                // ⛔ 여기서 transform을 즉시 .identity로 만들지 않는다 — 확대 상태가 원래 크기로 튄 뒤
+                //    회전하는 2단계가 됨. 확대 상태를 유지한 채 회전을 시작하면, viewWillTransition의
+                //    alongsideTransition에서 transform이 회전과 함께 애니메이션으로 초기화되어 부드럽게 풀스크린이 된다.
+                mutableOrientationStream.forceUpdateDeviceOrientation(
+                    deviceOrientation: .landscapeLeft,
+                    presenter: presenter
+                )
+            } else {
+                presenter.resetPlayerContainerTransform()
+            }
+        }
+
+        func handleCollapseGestureEnded(translation: CGPoint, velocity: CGPoint) {
+            // collapse 드래그(위/아래 무관)가 중앙 재생버튼(SwiftUI Button + DragGesture(minimumDistance:0))을
+            // 건드려 재생/일시정지가 토글될 수 있음 → commit/abort/멀티뷰 무관하게 제스처 직전 상태로 복원(양방향).
+            // 멀티뷰 가드보다 먼저 실행해야 멀티뷰 abort에서도 복원이 스킵되지 않는다.
+            // Task(@MainActor)는 버튼의 동기 togglePlayPause 이후 실행되어 복원이 이긴다(글리치 없음).
+            // 탭은 UIPanGestureRecognizer를 발동시키지 않으므로(이동 없음) 의도적 재생/일시정지 탭엔 영향 없다.
+            Task { @MainActor [weak self] in
+                guard let self else { return }
+                if collapseStartWasPlaying {
+                    mutableCurrentPlayerStream.player?.requestPlay()
+                } else {
+                    mutableCurrentPlayerStream.player?.pause()
+                }
+            }
+            guard isIPHONE, mutableCurrentPlayerStream.isFullViewValue,
+                !mutableCurrentPlayerStream.isMultiViewMode
+            else {
+                presenter.resetPlayerContainerTransform()
+                return
+            }
+            // 플레이어 높이 대비 commit 임계 비율 이상 내려갔거나 빠른 아래 플릭이면 세로로 복귀, 아니면 위로 복귀
+            let commitDistance = presenter.playerContainer.bounds.height * PlayerGestureTuning.collapseCommitRatio
+            // 거리·velocity commit 모두 수직 우세일 때만 — 좌우/대각선 제스처가 세로 전환을 오발동하지 않게.
+            let isTranslationVerticallyDominant = abs(translation.y) > abs(translation.x)
+            let isVelocityVerticallyDominant = abs(velocity.y) > abs(velocity.x)
+            let isFastDownwardFlick = velocity.y > PlayerGestureTuning.flickVelocity && isVelocityVerticallyDominant
+            if (translation.y > commitDistance && isTranslationVerticallyDominant) || isFastDownwardFlick {
+                presenter.playerContainer.transform = .identity
+                mutableOrientationStream.forceUpdateDeviceOrientation(
+                    deviceOrientation: .portrait,
+                    presenter: presenter
+                )
+            } else {
+                presenter.resetPlayerContainerTransform()
+            }
+        }
+
+        func handlePreviewExpandGestureEnded(reachedTop: Bool, velocity: CGPoint) {
+            // 나머지 3개 핸들러와 동일하게 멀티뷰는 제스처 차단 — 멀티뷰는 landscape 고정이라
+            // requestPlayContent()/회전을 시도하면 안 된다(회전 no-op + 재생 오발동).
+            guard isIPHONE, !mutableCurrentPlayerStream.isMultiViewMode else {
+                presenter.resetPlayerPreviewTransform()
+                return
+            }
+            // 위로 충분히 끌었거나 빠른 위 플릭이면 재생 시작 + 전체화면, 아니면 미리보기로 복귀
+            let isVerticallyDominant = abs(velocity.y) > abs(velocity.x)
+            let isFastUpwardFlick = velocity.y < -PlayerGestureTuning.flickVelocity && isVerticallyDominant
+            guard reachedTop || isFastUpwardFlick else {
+                presenter.resetPlayerPreviewTransform()
+                return
+            }
+            presenter.playerPreview.transform = .identity
+            // 미리보기 재생 버튼 탭과 동일 경로(인증 게이트 → 재생 시작) + 전체화면 회전
+            Task { @MainActor [weak self] in
+                guard let self else { return }
+                if await self.presentAuthGateIfNeeded(.playContents) { return }
+                self.hidePreview()
+                self.mutableCurrentPlayerStream.requestPlayContent()
+                self.mutableOrientationStream.forceUpdateDeviceOrientation(
+                    deviceOrientation: .landscapeLeft,
+                    presenter: self.presenter
+                )
+            }
+        }
+
+        func handlePreviewCollapseGestureEnded(translation: CGPoint, velocity: CGPoint) {
+            // 가로(전체화면) 미리보기에서 아래로 스와이프 → 세로 복귀. handleCollapseGestureEnded와 대칭이되
+            // 기준 뷰가 playerPreview다. 멀티뷰는 회전 no-op이라 스냅백.
+            guard isIPHONE, mutableCurrentPlayerStream.isFullViewValue,
+                !mutableCurrentPlayerStream.isMultiViewMode
+            else {
+                presenter.resetPlayerPreviewTransform()
+                return
+            }
+            let commitDistance = presenter.playerPreview.bounds.height * PlayerGestureTuning.collapseCommitRatio
+            // 거리·velocity commit 모두 수직 우세일 때만 — 좌우/대각선 제스처가 세로 전환을 오발동하지 않게.
+            let isTranslationVerticallyDominant = abs(translation.y) > abs(translation.x)
+            let isVelocityVerticallyDominant = abs(velocity.y) > abs(velocity.x)
+            let isFastDownwardFlick = velocity.y > PlayerGestureTuning.flickVelocity && isVelocityVerticallyDominant
+            if (translation.y > commitDistance && isTranslationVerticallyDominant) || isFastDownwardFlick {
+                presenter.playerPreview.transform = .identity
+                mutableOrientationStream.forceUpdateDeviceOrientation(
+                    deviceOrientation: .portrait,
+                    presenter: presenter
+                )
+            } else {
+                presenter.resetPlayerPreviewTransform()
+            }
+        }
+    }
+#endif
