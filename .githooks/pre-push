#!/usr/bin/env bash
# fz-plugin pre-push: 원격에 없는 커밋 · 태그에 공개 저장소에 두면 안 되는 식별자(신원 메일 · 개인 경로 · 메일 · 티켓 키 꼴 · PR 번호 꼴 · 합성 목록 밖 워크플로 실행 ID · 비공개 규칙)가 있으면 push 를 막는다
# diff-parse: not-a-diff — 이 훅은 diff 를 읽지 않는다. ref 갱신 줄로 검사 범위만 정하고, 커밋마다 추가 줄 추출과 판정은 누수 규칙 정본(scripts/leak_rules.py --commits)이 한다
#
# git 은 이 훅을 $1=원격 이름 · $2=원격 URL 로 부르고, stdin 에 갱신할 ref 마다 `<로컬 ref> <로컬 sha> <원격 ref> <원격 sha>` 한 줄을 준다.
#   이름 있는 원격 없이 URL 로 push 하면 $1 도 URL 이다
# 범위 — ref 마다 '로컬 sha 에서 닿고 원격 tip 에서 닿지 않는 커밋' 을 정본에 넘긴다(--commits=<로컬 sha> · 뺄 tip 마다 --exclude=<tip>).
#   ⛔ 원격 tip 은 push 가 실제로 가는 $2 에 ls-remote 해서 얻는다 — 추적 ref(origin/*)는 낡는다. 강제 push 뒤 prune 전에는 원격에 없는
#      옛 커밋을 가리켜, 그것으로 빼면 그 커밋을 '이미 공개' 로 여기고 검사 없이 올린다. ls-remote 가 실패하면 범위를 정하지 못해 막는다
#   ⛔ 원격 tip 가운데 로컬에서 커밋으로 풀리는 것만 뺀다. 풀리지 않는 tip(로컬에 없는 객체 — 고아 루트 강제 push 등)을 넘기면 정본이
#      그 끝을 풀지 못해 정상 push 를 판정 불가로 막는다. 빼지 않은 ref 는 로컬 sha 에서 닿는 커밋 전부를 본다(보수적 — 막지 않는다)
#   태그 ref(refs/tags/…)는 --tag 로 tagger · 주석 · 태그 이름도 본다. 목적지 ref 이름은 --ref-name 으로 넘긴다(push 하면 그 이름이
#   공개된다). 삭제(로컬 sha 가 0)는 건너뛴다. 모든 줄을 본다 — 깨끗한 줄 다음 줄도 보고
#   하나라도 적중 · 미판정이면 막는다. 병합 커밋은 첫 부모와의 차이로 본다(정본의 커밋마다 축)
# 정책(--hook-policy): 비공개 규칙은 env FZ_NEUTRALIZE_RULES > git 설정 fz.neutralizeRules 에서 찾고, 없을 때 유지관리자 표지(git 설정
#   fz.maintainer)가 참이면 미판정이다. 커밋 · 태그의 신원 메일 규칙(noreply 만 통과)은 표지가 참일 때만 켠다 — 공개 기여자의 개인
#   메일은 막지 않는다. 비공개 규칙은 표지와 무관하게 신원 칸(author · committer · tagger 의 이름 · 메일)에도 본다
# ⛔ 정본은 훅 위치 기준으로 찾는다 — cwd 는 push 하는 저장소이고 그 안에 scripts/ 가 있다는 보장이 없다. 없으면 배선이 끊긴 것이라 막는다
# ⛔ 훅이 내는 줄에는 원격 URL 원문을 싣지 않는다(show_url) — push URL 에 자격 증명(`user:token@`)을 넣어 둔 사용자의 토큰이 터미널 ·
#    CI 로그에 찍힌다. git ls-remote 자신이 내는 오류 줄은 git 이 쓴다(이 훅이 고치지 않는다)
# exit: 0 = 통과(검사할 ref 없음 포함) · 1 = 막음(적중 · 미판정 · 배선 끊김). set -e — 받지 않은 명령이 실패하면 그 자리에서 0 이 아닌
#   값으로 끝난다(막는 쪽이다). 0 아닌 종료를 판정에 쓰는 명령은 `|| X=$?` 로 받는다
set -euo pipefail
# replace ref 를 따르지 않는다 — 이 훅의 git 조회(원격 tip 벗기기 · 객체 종류)도 정본처럼 원본 객체를 읽는다. 따르면 원격에 있는
#   태그 객체를 로컬에서 바꿔치기해 미공개 커밋을 '원격이 가진 tip' 으로 뺄 수 있다 — 그 커밋은 검사 없이 나간다
export GIT_NO_REPLACE_OBJECTS=1

LEAK_RULES="$(dirname "$0")/../scripts/leak_rules.py"
URL="${2:-}"
NL=$'\n'
TAB=$'\t'
# ⛔ 원인별 수 — 하나로 뭉치면 막은 이유와 안내가 어긋난다(커밋 훅과 같은 이유). UNWIRED = 정본 · python3 를 찾지 못함
NHIT=0
NUNRUN=0
UNWIRED=0
NDEL=0
TODO=""   # 검사할 줄(삭제 제외) — `<로컬 ref> <로컬 sha> <원격 ref>` 한 줄씩

is_oid() {   # 객체 이름 꼴(소문자 16진 40자 · 64자)
  case "$1" in ''|*[!0-9a-f]*) return 1 ;; esac
  [ ${#1} -eq 40 ] || [ ${#1} -eq 64 ]
}
is_zero() {   # 0 으로만 된 객체 이름 — 삭제
  case "$1" in *[!0]*) return 1 ;; esac
  return 0
}
show_url() {   # 출력용 URL — `스킴://` 뒤 권한부(첫 `/` 앞)의 사용자 정보를 걷는다. 그 밖의 꼴(scp 꼴 · 로컬 경로)은 그대로 낸다
  case "$1" in
    *://*)
      local scheme="${1%%://*}" after="${1#*://}" auth
      auth="${after%%/*}"
      case "$auth" in
        *@*) printf '%s://(사용자 정보 걷음)@%s%s' "$scheme" "${auth##*@}" "${after:${#auth}}" ;;
        *) printf '%s' "$1" ;;
      esac
      ;;
    *) printf '%s' "$1" ;;
  esac
}
SHOWN_URL="$(show_url "$URL")"

# ── ref 갱신 줄 — ⛔ 형식 밖 줄은 범위를 정하지 못한 것이라 미판정이다(건너뛰면 그 ref 가 검사 없이 나간다)
while IFS=' ' read -r lref lsha rref rsha rest || [ -n "${lref:-}" ]; do
  if [ -z "$lref$lsha$rref$rsha" ]; then
    lref=""; continue
  fi
  if [ -n "$rest" ] || [ -z "$rref" ] || ! is_oid "$lsha" || ! is_oid "$rsha"; then
    echo "⛔ fz pre-push: ref 갱신 줄을 읽지 못했다($lref $lsha $rref $rsha $rest) — 검사 범위를 정하지 못했다"
    NUNRUN=$((NUNRUN + 1))
  elif is_zero "$lsha"; then
    NDEL=$((NDEL + 1))
  else
    TODO="$TODO$lref $lsha $rref$NL"
  fi
  lref=""
done

if [ -z "$TODO" ] && [ "$NUNRUN" -eq 0 ]; then
  [ "$NDEL" -eq 0 ] || echo "fz pre-push: 삭제만 있다(ref ${NDEL}개) — 내보내는 커밋이 없어 누수 검사를 건너뛴다"
  exit 0
fi

if [ -n "$TODO" ]; then
  if [ ! -f "$LEAK_RULES" ]; then
    echo "⛔ fz pre-push: 누수 규칙 정본을 찾지 못했다($LEAK_RULES) — 배선이 끊겨 판정할 수 없어 push 를 막는다"
    UNWIRED=1
  elif ! command -v python3 >/dev/null 2>&1; then
    echo "⛔ fz pre-push: python3 를 찾지 못했다 — 누수 규칙 정본을 돌릴 수 없어 push 를 막는다"
    UNWIRED=1
  fi
fi

# ── 원격 tip → 뺄 끝(EXCL — 로컬에서 커밋으로 풀린 것 · 벗긴 커밋 이름) · 빼지 않은 tip 수(NSKIP). TIP_RC 가 0 이 아니면 범위를 못 정했다
EXCL=()
NEXCL=0
NSKIP=0
TIP_RC=0
if [ -n "$TODO" ] && [ "$UNWIRED" -eq 0 ]; then
  LS_OUT=""
  case "$URL" in
    ''|-*) TIP_RC=2; echo "⛔ fz pre-push: 원격 URL 이 비었거나 '-' 로 시작한다('$SHOWN_URL')" ;;
    *) LS_OUT="$(git ls-remote "$URL")" || TIP_RC=$? ;;
  esac
  TIPS="" NTIPS=0
  if [ "$TIP_RC" -eq 0 ]; then
    while IFS="$TAB" read -r sha ref; do
      [ -n "$sha$ref" ] || continue
      if ! is_oid "$sha"; then
        echo "⛔ fz pre-push: ls-remote 출력이 형식 밖이다($sha $ref)"; TIP_RC=2; break
      fi
      case "$NL$TIPS" in
        *"$NL$sha$NL"*) ;;
        *) TIPS="$TIPS$sha$NL"; NTIPS=$((NTIPS + 1)) ;;
      esac
    done <<< "$LS_OUT"
  fi
  if [ "$TIP_RC" -eq 0 ] && [ "$NTIPS" -gt 0 ]; then
    # 로컬에서 풀리는가 — tip 마다 `<tip>^{commit}` 을 한 번에 묻는다(cat-file -e 와 같은 술어 · tip 마다 git 을 띄우지 않는다).
    #   풀리면 `<커밋> commit <크기>`, 로컬에 없는 객체 · 커밋으로 벗겨지지 않는 객체(트리 · blob 을 가리키는 ref)는 `<입력> missing`
    CK_OUT="$(printf '%s^{commit}\n' $TIPS | git cat-file --batch-check)" || TIP_RC=$?
    if [ "$TIP_RC" -eq 0 ]; then
      SEEN="$NL" NANS=0
      while read -r oid kind size; do
        [ -n "$oid" ] || continue
        NANS=$((NANS + 1))
        if [ "$kind" = commit ] && is_oid "$oid"; then
          case "$SEEN" in
            *"$NL$oid$NL"*) ;;
            *) SEEN="$SEEN$oid$NL"; EXCL+=("--exclude=$oid"); NEXCL=$((NEXCL + 1)) ;;
          esac
        else
          NSKIP=$((NSKIP + 1))
        fi
      done <<< "$CK_OUT"
      if [ "$NANS" -ne "$NTIPS" ]; then
        echo "⛔ fz pre-push: git cat-file 이 원격 tip ${NTIPS}개 가운데 ${NANS}개에만 답했다"; TIP_RC=2
      fi
    fi
  fi
  if [ "$TIP_RC" -ne 0 ]; then
    echo "⛔ fz pre-push: 원격 tip 을 읽지 못했다(git exit $TIP_RC — $SHOWN_URL) — 원격에 없는 커밋의 범위를 정할 수 없어 누수 검사 미판정"
    NUNRUN=$((NUNRUN + 1))
  fi
fi

# ── ref 마다 정본을 부른다 — ⛔ 첫 적중에서 멈추지 않는다(뒤의 ref 도 본다)
if [ -n "$TODO" ] && [ "$UNWIRED" -eq 0 ] && [ "$TIP_RC" -eq 0 ]; then
  while IFS=' ' read -r lref lsha rref; do
    [ -n "$lsha" ] || continue
    TAGS=()
    case "$lref" in
      refs/tags/?*) TAGS=("--tag=$lref") ;;
      *)
        # 태그 객체를 태그 ref 가 아닌 이름으로 밀면 --tag 로 넘길 이름이 없다 — tagger · 주석을 보지 못한 채 통과시키지 않는다.
        #   객체 종류를 읽지 못하면(로컬에 없는 객체 · git 실패) 정본이 범위를 풀지 못해 판정 불가로 막는다
        if [ "$(git cat-file -t "$lsha" 2>/dev/null </dev/null)" = tag ]; then
          echo "⛔ fz pre-push: 태그 객체를 태그 ref 가 아닌 이름($lref → $rref)으로 민다 — tagger · 주석을 볼 수 없어 누수 검사 미판정"
          NUNRUN=$((NUNRUN + 1))
          continue
        fi
        ;;
    esac
    echo "── fz pre-push: $lref → $rref (${lsha:0:12}) · 뺀 원격 tip ${NEXCL}개 · 풀리지 않아 빼지 않은 tip ${NSKIP}개"
    # 정본 exit: 0 = 쟀고 적중 0(끝 줄 LEAK_CLEAN) · 1 = 적중(끝 줄 LEAK_HIT) · 2 = 판정 불가. ⛔ 종료 코드와 끝 줄을 함께 본다 —
    #   파이썬 예외도 exit 1 이라 종료 코드만 보면 충돌을 적중으로 안내한다(커밋 훅과 같은 판정). `|| RC=$?` — set -e 아래에서 0 아닌
    #   종료가 훅을 그 자리에서 끝내지 않게 받는다. stdin 을 끊는다 — 이 루프의 줄을 먹지 않게
    RC=0
    # 목적지 ref 이름도 넘긴다 — push 하면 그 이름이 공개된다(로컬 이름이 깨끗해도 `main:refs/heads/<사적 이름>` 으로 나갈 수 있다)
    OUT="$(python3 "$LEAK_RULES" --hook-policy "--commits=$lsha" "--ref-name=$rref" ${EXCL[@]+"${EXCL[@]}"} ${TAGS[@]+"${TAGS[@]}"} </dev/null)" || RC=$?
    [ -z "$OUT" ] || printf '%s\n' "$OUT"
    LAST=${OUT##*$NL}
    case "$RC:$LAST" in
      "0:LEAK_CLEAN "*) ;;
      "1:LEAK_HIT "*) NHIT=$((NHIT + 1)) ;;
      *) echo "⛔ fz pre-push: $lref 누수 검사 미판정(정본 exit $RC — 위 출력의 UNRUN 줄 · 오류)"; NUNRUN=$((NUNRUN + 1)) ;;
    esac
  done <<< "$TODO"
fi

if [ "$NHIT" -gt 0 ]; then
  echo "⛔ fz pre-push: 내보낼 커밋 · 태그에 공개 저장소에 두면 안 되는 식별자가 있다(위 ❌ 줄 · ref ${NHIT}개)"
fi
if [ "$NUNRUN" -gt 0 ]; then
  echo "⛔ fz pre-push: 누수 검사 미판정 ${NUNRUN}건 — 판정할 수 없어 push 를 막는다"
fi
if [ "$NHIT" -eq 0 ] && [ "$NUNRUN" -eq 0 ] && [ "$UNWIRED" -eq 0 ]; then
  exit 0
fi
if [ "$UNWIRED" -eq 0 ]; then
  echo ""
  echo "검사 범위: 갱신하는 ref 마다 원격에 없는 커밋(로컬 sha 에서 닿고, ls-remote 로 얻은 원격 tip 가운데 로컬에서 풀리는 것에서 닿지 않는 커밋) · 태그 ref 의 tagger · 주석 · 목적지 ref 이름"
  echo "검사 축: 커밋마다 신원(author · committer) · 메시지 · 그 밖의 머리 · 추가 줄과 새 파일 · 폴더 이름(첫 부모 대비) · 태그 ref 의 tagger · 주석 · 태그 이름과 목적지 ref 이름 —"
  echo "      개인 홈 경로 · 개인 작업 폴더 경로 · 허용 밖 메일 · 티켓 키 꼴 · PR 번호 꼴 · 예약 번호 밖 자리표시자 · 합성 목록 밖 워크플로 실행 ID · 비공개 규칙"
  echo "      신원 칸(author · committer · tagger)의 신원 메일 규칙(noreply 만 통과)은 유지관리자 표지(git 설정 fz.maintainer)가 참일 때만 · 비공개 규칙은 언제나"
  echo "통과: 자리표시 경로(정본의 DOC_HOME_NAMES · DOC_DEV_NAMES) · 예약 번호(0 으로 시작하는 3~5자리)를 쓴 자리표시자 ·"
  echo "      합성 실행 ID(정본의 SYNTHETIC_RUN_IDS — 실제 실행 ID 는 줄여 적은 것도 그 목록의 값으로 바꾼다)"
  echo "미판정도 막는다: ls-remote 실패 · git 실패 · 바이너리 파일 · UTF-8 이 아닌 줄 · 비공개 규칙 파일을 읽지 못함 ·"
  echo "      유지관리자 표지가 있는데 비공개 규칙 파일이 없거나 규칙이 0개"
fi
echo ""
echo "Bypass (정당 사유 시): git push --no-verify (권장 안 함)"
echo "  우회하면 이 검사는 다시 돌지 않는다 — 출하 게이트(scripts/check_release_sync.sh --release)는 출하 범위(직전 출하 태그 뒤 HEAD 까지의 커밋)와"
echo "  로컬 태그만 같은 정본으로 본다. 출하하지 않는 브랜치를 우회해 밀면 어느 검사도 보지 않는다"
exit 1
